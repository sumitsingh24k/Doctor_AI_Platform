# Twilio Voice. Keep the real values only in .env; never commit that file.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Public HTTPS URL that Twilio can reach. No trailing slash.
# Example during local testing: https://your-random-url.ngrok-free.app
TWILIO_WEBHOOK_BASE_URL=https://your-public-domain.example

# Secret used only by your frontend/admin service to call POST /api/assistant/twilio/call.
TWILIO_CALL_API_KEY=replace-with-a-long-random-secret

# Local trial testing only. Remove it or set it to false before deployment.
TWILIO_ALLOW_UNSIGNED_WEBHOOKS=false

# At least 32 random characters. Used to sign doctor-agent and OAuth state tokens.
AGENT_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Required for clinic PDF indexing and knowledge-base search.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Required for assistant voice transcription and spoken replies.
# Create a key in your Sarvam AI account dashboard.
SARVAM_API_KEY=replace-with-your-sarvam-api-key

# Google Calendar OAuth credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# Register this exact URL as an authorized redirect URI for the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback
# Frontend URL to return to after approving or cancelling Google access.
FRONTEND_URL=http://localhost:5173
GOOGLE_CALENDAR_TIME_ZONE=Asia/Kolkata

# Transitional single-doctor setup.
TWILIO_DEFAULT_DOCTOR_ID=replace-with-doctor-object-id
